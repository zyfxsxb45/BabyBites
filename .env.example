# ===== LLM API 配置 =====
# 支持 OpenAI 兼容 API（OpenAI / DeepSeek / 硅基流动 / 阿里百炼 等）
#
# DeepSeek:
#   OPENAI_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-v4-flash  |  deepseek-v4-pro  |  deepseek-chat  |  deepseek-reasoner
#
# OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini  |  gpt-4o
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 知识库后端选择 =====
# 可选值: json | neo4j
# json: 使用 JSON + SQLite（默认，无需额外服务）
# neo4j: 使用 Neo4j 图数据库（需先启动 Neo4j 服务）
KB_BACKEND=json

# ===== Neo4j 连接配置（仅当 KB_BACKEND=neo4j 时需要）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# ===== 数据路径（通常不需要修改）=====
DATA_DIR=data/knowledge
DB_PATH=data/database/babybites.db

# ===== 调试开关 =====
DEBUG=true
LOG_LEVEL=INFO
